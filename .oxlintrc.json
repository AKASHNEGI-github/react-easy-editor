{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    ".iso/**",
    "node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "src/plugins/**",
        "src/core/**",
        "src/demo/**",
        "tests/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
